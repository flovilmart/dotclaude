{
  "permissions": {
    "allow": [
      "mcp__plugin_linear_linear__list_teams",
      "mcp__plugin_linear_linear__save_issue",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-create-pages",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(node:*)",
      "Bash(nu:*)",
      "Bash(pnpm:*)",
      "Bash(npx oxfmt:*)",
      "Bash(gh pr create:*)",
      "Bash(grep:*)",
      "Bash(uv:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git worktree:*)",
      "mcp__plugin_linear_linear__list_issues",
      "mcp__plugin_linear_linear__get_issue",
      "mcp__plugin_linear_linear__list_cycles",
      "mcp__plugin_linear_linear__list_comments",
      "mcp__plugin_linear_linear__save_comment",
      "mcp__plugin_linear_linear__list_issue_statuses",
      "Bash(claude agents:*)",
      "Bash(claude logs:*)",
      "Bash(claude --version:*)",
      "Bash(gh stack:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh extension list:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh 'input_required'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh 'complete'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "Notion@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "linear@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "crossSessionInbound": "accept"
}
