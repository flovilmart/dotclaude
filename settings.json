{
  "permissions": {
    "allow": [
      "mcp__plugin_linear_linear__list_teams",
      "mcp__plugin_linear_linear__save_issue",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-create-pages",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(nu:*)",
      "Bash(pnpm:*)",
      "Bash(npx oxfmt:*)",
      "Bash(gh pr create:*)",
      "Bash(grep:*)",
      "Bash(uv:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git worktree:*)",
      "mcp__plugin_linear_linear__list_issues",
      "mcp__plugin_linear_linear__get_issue",
      "mcp__plugin_linear_linear__list_cycles",
      "mcp__plugin_linear_linear__list_comments",
      "mcp__plugin_linear_linear__save_comment",
      "mcp__plugin_linear_linear__list_issue_statuses",
      "Bash(claude agents:*)",
      "Bash(claude logs:*)",
      "Bash(claude --version:*)",
      "Bash(gh stack:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh extension list:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh api:*)",
      "Bash(claude --resume:*)",
      "Bash(psql -h localhost:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh 'input_required'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh 'complete'"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-log.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-log.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-log.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "Notion@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "vanta-mcp-plugin@claude-plugins-official": true,
    "posthog@claude-plugins-official": false,
    "slack@anthropic-plugin-directory": true
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
